{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/office", "destination": "/office.html" },
    { "source": "/office/", "destination": "/office.html" }
  ]
}
